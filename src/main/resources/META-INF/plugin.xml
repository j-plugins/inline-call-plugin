<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.xepozz.inline_call</id>
    <name>Inline Call</name>
    <vendor email="xepozz@list.ru" url="https://github.com/xepozz">Dmitrii Derepko (@xepozz)</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="language-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="language-xml.xml">com.intellij.modules.xml</depends>

    <depends optional="true" config-file="language-php.xml">com.jetbrains.php</depends>
    <depends optional="true" config-file="language-yaml.xml">org.jetbrains.plugins.yaml</depends>

    <resource-bundle>messages.CallBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.inlayActionHandler
                handlerId="inline_call.execution.run"
                implementationClass="com.github.xepozz.inline_call.base.inlay.RunInlayActionHandler"/>
        <codeInsight.inlayActionHandler
                handlerId="inline_call.execution.stop"
                implementationClass="com.github.xepozz.inline_call.base.inlay.StopInlayActionHandler"/>
        <codeInsight.inlayActionHandler
                handlerId="inline_call.execution.delete"
                implementationClass="com.github.xepozz.inline_call.base.inlay.DeleteInlayActionHandler"/>
        <codeInsight.inlayActionHandler
                handlerId="inline_call.execution.toggle_collapse"
                implementationClass="com.github.xepozz.inline_call.base.inlay.ToggleCollapseInlayActionHandler"/>
    </extensions>

    <extensionPoints>
        <extensionPoint
                dynamic="true"
                interface="com.github.xepozz.inline_call.base.api.LanguageTextExtractor"
                area="IDEA_PROJECT"
                name="languageTextExtractor"/>
        <extensionPoint
                dynamic="true"
                interface="com.github.xepozz.inline_call.base.api.FeatureGenerator"
                area="IDEA_PROJECT"
                name="feature"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.github.xepozz.inline_call">
        <languageTextExtractor
                order="last"
                implementation="com.github.xepozz.inline_call.base.extractors.AdapterLanguageExtractor"/>
        <feature implementation="com.github.xepozz.inline_call.feature.shell.ShellFeatureAdapter"/>
        <feature implementation="com.github.xepozz.inline_call.feature.http.HttpFeatureAdapter"/>
    </extensions>
</idea-plugin>
